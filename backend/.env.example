# Garmin login (unofficial API — your normal Garmin Connect credentials)
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-garmin-password

# Claude API key (from console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Your training goal — fed to the Claude coaching prompts (morning brief + Ask Coach)
TRAINING_GOAL=Get genuinely faster at 5K/10K run and threshold cycling while holding ~40 mi/week running and 100+ mi/week riding

# Optional — only set these when training for a specific race
# RACE_NAME=Chicago Marathon
# RACE_DATE=2026-10-11
